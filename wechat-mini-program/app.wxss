page {
  width: 100%;
  height: 100%;
  margin: 0;
  color: #303538;
  background: #f5f6f6;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
  letter-spacing: 0;
}

view,
button,
image {
  box-sizing: border-box;
  letter-spacing: 0;
}

button {
  margin: 0;
  border-radius: 6rpx;
  line-height: 1.2;
}

button::after { border: 0; }
