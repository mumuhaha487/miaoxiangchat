APP_NAME=妙想之地
APP_PORT=53138
PROJECT_HOST_DIR=/opt/miaoxiang
PUBLIC_APP_ORIGIN=https://example.com

# Generated independently by scripts/initialize.sh. Never commit real values.
APP_SECRET=
ACTIVATION_SECRET=
INTERNAL_BROWSER_KEY=
HERMES_API_KEY=
ADMIN_USERNAME=project-admin
ADMIN_PASSWORD=

SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_CLOUD_BRIDGE_SECRET=

# OpenAI-compatible primary/executor model. Values below are examples only.
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=
LLM_MODEL=your-model-name
MODEL_SPLIT_ENABLED=false
CHAT_LLM_BASE_URL=https://api.example.com/v1
CHAT_LLM_API_KEY=
CHAT_LLM_MODEL=your-chat-model
COORDINATOR_LLM_BASE_URL=https://api.example.com/v1
COORDINATOR_LLM_API_KEY=
COORDINATOR_LLM_MODEL=your-coordinator-model
LLM_CONTEXT_LENGTH=131072
LLM_MAX_RETRIES=8
LLM_CONCURRENCY_LIMIT=12
LLM_VERIFY_TLS=true
LLM_PROXY=

# The host proxy is intentionally loopback-only. proxy-bridge exposes it only
# on the Docker host gateway so isolated Worker/Chromium containers can use it.
OUTBOUND_PROXY_ENABLED=false
OUTBOUND_PROXY_URL=http://127.0.0.1:10808
OUTBOUND_PROXY_CONTAINER_URL=http://host.docker.internal:10809
PROXY_BRIDGE_BIND_HOST=172.17.0.1
PROXY_BRIDGE_BIND_PORT=10809

HERMES_IMAGE=mumu-hermes-worker:local
HERMES_DYNAMIC_WORKERS=true
HERMES_MIN_ACTIVE_WORKERS=2
HERMES_MAX_ACTIVE_WORKERS=8
HERMES_MEMORY_RESERVE_GIB=4
HERMES_WORKER_MEMORY_BUDGET_GIB=1.5
HERMES_CPU_RESERVE=2
HERMES_IDLE_MINUTES=30
HERMES_MEMORY_LIMIT=3g
HERMES_CPU_LIMIT=2
HERMES_MAX_TURNS=1200
HERMES_GATEWAY_TIMEOUT=43200
HERMES_GATEWAY_NOTIFY_INTERVAL=180

EXPERT_QUALITY_THRESHOLD=82
EXPERT_MAX_REVISIONS=3
EXPERT_MAX_REVIEW_IMAGES=200

BROWSER_IMAGE=mumu-browser-runtime:local
BROWSER_IDLE_MINUTES=60
BROWSER_MEMORY_LIMIT=1100m
BROWSER_CPU_LIMIT=1
UPLOAD_MAX_BYTES=104857600
REGISTRATION_ENABLED=true
